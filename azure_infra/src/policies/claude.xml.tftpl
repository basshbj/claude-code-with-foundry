<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="${tenant_id}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Missing or invalid Entra ID access token." output-token-variable-name="gateway-jwt">
      <audiences>
        <audience>${gateway_client_id}</audience>
      </audiences>
    </validate-azure-ad-token>
    <choose>
      <when condition='@(string.IsNullOrEmpty(((Jwt)context.Variables["gateway-jwt"]).Claims.GetValueOrDefault("oid", "")))'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"type":"error","error":{"message":"An Entra object identity is required.","type":"permission_error"}}</set-body>
        </return-response>
      </when>
      <when condition='@(!((Jwt)context.Variables["gateway-jwt"]).Claims.ContainsKey("roles") || !((Jwt)context.Variables["gateway-jwt"]).Claims["roles"].Contains("${gateway_role}"))'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"type":"error","error":{"message":"The required Claude gateway app role is missing.","type":"permission_error"}}</set-body>
        </return-response>
      </when>
    </choose>
    <set-variable name="caller-id" value='@(((Jwt)context.Variables["gateway-jwt"]).Claims.GetValueOrDefault("tid", "") + ":" + ((Jwt)context.Variables["gateway-jwt"]).Claims.GetValueOrDefault("oid", ""))' />
    <rate-limit-by-key calls="${requests_per_minute}" renewal-period="60" counter-key='@((string)context.Variables["caller-id"])' remaining-calls-header-name="x-ratelimit-remaining" />
    <set-variable id="parse-model" name="requested-model" value='@{
      var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
      var model = body != null ? body["model"] : null;
      return model != null &amp;&amp; model.Type == JTokenType.String ? (string)model : "";
    }' />
    <choose>
      <when condition='@(!JArray.Parse(${allowed_models}).Values&lt;string&gt;().Contains((string)context.Variables["requested-model"]))'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"type":"error","error":{"message":"A valid JSON object with an approved model deployment name is required.","type":"invalid_request_error"}}</set-body>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition='@(context.Operation.Id == "messages")'>
        <llm-token-limit counter-key='@((string)context.Variables["caller-id"])' tokens-per-minute="${tokens_per_minute}" token-quota="${monthly_token_quota}" token-quota-period="Monthly" estimate-prompt-tokens="true" remaining-tokens-header-name="x-tokens-remaining" remaining-quota-tokens-header-name="x-token-quota-remaining" />
        <llm-emit-token-metric namespace="claudecode">
          <dimension name="UserId" value='@(((Jwt)context.Variables["gateway-jwt"]).Claims.GetValueOrDefault("oid", ""))' />
          <dimension name="Model" value='@((string)context.Variables["requested-model"])' />
        </llm-emit-token-metric>
      </when>
    </choose>
    <set-header name="api-key" exists-action="delete" />
    <set-header name="x-api-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-backend-service backend-id="${backend_id}" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" ignore-error="false" />
  </inbound>
  <backend>
    <forward-request timeout="240" buffer-response="false" fail-on-error-status-code="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
    <choose>
      <when condition='@(context.LastError.PolicyId == "parse-model")'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"type":"error","error":{"message":"The request body must be a valid JSON object.","type":"invalid_request_error"}}</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
