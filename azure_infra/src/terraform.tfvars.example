# Copy to terraform.tfvars and replace all placeholders before planning.
subscription_id = "REPLACE_WITH_SUBSCRIPTION_ID"
tenant_id       = "REPLACE_WITH_TENANT_ID"
name_prefix     = "claude-demo-unique"
location        = "eastus2"

# A NEW resource group is always created. Null derives <name_prefix>-rg.
resource_group_name = null
apim_sku_name       = "StandardV2_1"
publisher_name      = "Example organization"
publisher_email     = "azure-admin@example.com"

# Authorize existing users by email and/or security groups by exact display name.
allowed_user_emails = ["developer@example.com"]
allowed_group_names = []
# Object IDs may identify users, security groups, or service principals.
# Assigns the gateway app role; group-based app access covers direct members only.
allowed_principal_object_ids = []
requests_per_minute = 60
tokens_per_minute   = 50000
monthly_token_quota = 5000000
log_retention_days  = 30

# Applying sends these attestations and accepts the Anthropic Marketplace terms.
# Replace with the actual legal organization, country, and industry before planning.
claude_organization_name = "REPLACE_WITH_LEGAL_ORGANIZATION"
claude_country_code      = "US"
claude_industry          = "technology"

# One deployment per model, pinned to version 2 (Hosted on Azure).
# Verify model availability, subscription eligibility, and quota before applying.
models = [
  "claude-opus-4-8",
  "claude-opus-5-5",
  "claude-haiku-4-5",
  "claude-sonnet-5",
  "claude-opus-5",
  "claude-sonnet-5-5",
  "claude-haiku-5-5",
]

# Shared plan and capacity for every model in the list.
# GlobalStandard may process data outside the resource region.
# Capacity units depend on the selected model/SKU; check Azure quota documentation.
model_deployment_sku_name = "GlobalStandard"
model_deployment_capacity = 1

tags = {
  environment = "dev"
  workload    = "claude-foundry"
}
